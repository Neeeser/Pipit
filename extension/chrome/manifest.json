{
  "manifest_version": 3,
  "name": "Pipit Sensor",
  "version": "1.0.1",
  "description": "Reports Google Meet and Zoom meeting state to Pipit so it records the right calls.",
  "key": "",
  "icons": {
    "48": "icons/pipit-48.png",
    "96": "icons/pipit-96.png",
    "128": "icons/pipit-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*"
  ],
  "background": {
    "service_worker": "shared/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "shared/provider.js",
        "shared/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
